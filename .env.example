# ===================================================================
# University Reservation Service Environment Variables Configuration
# Copy this file to .env or export these variables in your environment.
# DO NOT commit actual secrets or production passwords to repository!
# ===================================================================

# -------------------------------------------------------------------
# Server Configuration
# -------------------------------------------------------------------
# HTTP server port for reservation-service (Default: 8082)
SERVER_PORT=8082

# Spring active profile (e.g. dev, prod, test)
# SPRING_PROFILES_ACTIVE=dev

# -------------------------------------------------------------------
# Database Configuration (MySQL for Production / H2 for Dev & Test)
# -------------------------------------------------------------------
# Database JDBC Connection URL
# Production example: jdbc:mysql://localhost:3306/reservation_db?useSSL=false&allowPublicKeyRetrieval=true
# Default fallback: in-memory H2 database
SPRING_DATASOURCE_URL=jdbc:h2:mem:reservationdb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE

# Database Username
DB_USERNAME=sa

# Database Password (Keep blank in .env.example)
DB_PASSWORD=

# Hibernate DDL Auto Schema Strategy (e.g. update, validate, create-drop, none)
SPRING_JPA_DDL_AUTO=update

# -------------------------------------------------------------------
# External Microservices Integration URLs
# -------------------------------------------------------------------
# Group 5 Identity Access Service Base URL
# Local default: http://localhost:8001 | Docker default: http://identity-service:8001
IDENTITY_SERVICE_URL=http://localhost:8001

# Group 6 Facility Resource Service Base URL
# Local default: http://localhost:8081 | Docker default: http://facility-resource-service:8081
FACILITY_SERVICE_URL=http://localhost:8081

# Enable/Disable remote Group 5 Identity Service integration calls (true / false)
GROUP5_INTEGRATION_ENABLED=true

# -------------------------------------------------------------------
# JWT & Security Configuration
# -------------------------------------------------------------------
# Optional explicit override for JWKS URI endpoint
# Default derived: ${IDENTITY_SERVICE_URL}/.well-known/jwks.json
# IDENTITY_SERVICE_JWKS_URI=http://localhost:8001/.well-known/jwks.json

# JWT Roles Claim Key Name (Default: roles)
RESERVATION_SERVICE_JWT_ROLES_CLAIM=roles

# Required JWT Issuer Name (Default: university-identity-service)
RESERVATION_SERVICE_JWT_REQUIRED_ISSUER=university-identity-service

# Required JWT Audience Name (Default: university-services-platform)
RESERVATION_SERVICE_JWT_REQUIRED_AUDIENCE=university-services-platform
